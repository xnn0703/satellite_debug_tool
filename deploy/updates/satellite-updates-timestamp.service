[Unit]
Description=Renew Satellite Terminal Tool TUF timestamp metadata
After=local-fs.target
OnFailure=satellite-updates-failure@%n.service

[Service]
Type=oneshot
User=satellite_meta
Group=satellite_meta
WorkingDirectory=/opt/satellite-updates/tools
ExecStart=/opt/satellite-updates/venv/bin/python /opt/satellite-updates/tools/scripts/update_repository.py refresh-timestamp --repository /srv/satellite-updates/public/v1/apps/satellite-terminal-tool --key-dir /etc/satellite-updates/online-keys --promotion-lock /srv/satellite-updates/receipts/satellite-terminal-tool.publication.lock
TimeoutStartSec=120
UMask=0022
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/satellite-updates/public/v1/apps/satellite-terminal-tool/metadata /srv/satellite-updates/public/v1/apps/satellite-terminal-tool/publish.lock /srv/satellite-updates/receipts
RestrictAddressFamilies=AF_UNIX
StandardOutput=journal
StandardError=journal
SyslogIdentifier=satellite-updates-timestamp
